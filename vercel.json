{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "semanticeconomy.org"
        }
      ],
      "destination": "https://www.semanticeconomy.org/:path*",
      "permanent": true
    }
  ],
  "trailingSlash": false
}